# Meta Model API (Muse) credentials.
# Copy this file to .env and fill in your key from https://dev.meta.ai
# The key is only read by the dev-server proxy (Node side). It is never sent to the browser.
MUSE_API_KEY=

# Optional overrides
MUSE_API_BASE=https://api.meta.ai/v1
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_VISION_MODEL=muse-spark-1.3
